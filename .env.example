# ==============================================================================
# Sprints Multi-Agent Orchestrator - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# 1. LLM API Key (Google Gemini 2.5 Flash)
# When set with SPRINTS_LIVE_API=true, orchestrator invokes live Gemini models.
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Environment Mode (development | staging | production)
# In production/staging, strict cryptographic key isolation is enforced.
SPRINTS_ENV=development

# 3. Cryptographic Governance & Authentication Keys
# Mandatory in production/staging; must be distinct, high-entropy secrets.
HITL_AUTH_SECRET=sprints-hitl-secure-governance-secret-key-2026
DB_CALLER_AUTH_SECRET=sprints-db-caller-secure-authorization-secret-2026

# 4. Human-in-the-Loop Institutional Reviewer Credentials
# Used for CLI and automated verification. If unset in demo mode, ephemeral
# HMAC-SHA256 signed session tokens are issued without plaintext passwords.
SPRINTS_REVIEWER_USER=sarah_lead
SPRINTS_REVIEWER_PASSWORD=your_secure_reviewer_password_here

# 5. Production Reviewer Account Provisioning
# In production, default built-in accounts are deactivated unless set to true.
SPRINTS_ENABLE_DEMO_REVIEWERS=false

# 6. Execution Modes
SPRINTS_LIVE_API=false

# 7. Container Runtime Security (runc | runsc / gVisor | kata)
# Requires corresponding host OCI runtime installation when set to runsc/kata.
SPRINTS_DOCKER_RUNTIME=runc
